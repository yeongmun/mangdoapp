{
  "expo": {
    "name": "망도 손상조사",
    "slug": "mangdo-app",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.mangdoapp"
    },
    "android": {
      "package": "com.yourcompany.mangdoapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      ["expo-image-picker", { "cameraPermission": "손상 사진을 찍기 위해 카메라를 씁니다." }],
      ["expo-media-library", { "savePhotosPermission": "찍은 사진을 앨범에 저장합니다.", "isAccessMediaLocationEnabled": false }]
    ]
  }
}
