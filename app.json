{
  "expo": {
    "name": "농농",
    "slug": "mangdo-app",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.mangdoapp"
    },
    "android": {
      "package": "com.yourcompany.mangdoapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "손상 사진을 찍기 위해 카메라를 씁니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "현장 사진을 찍기 위해 카메라를 씁니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 구조물을 찾고 사진 찍은 자리를 기록하기 위해 위치를 씁니다.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "찍은 사진을 앨범에 저장합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "69773266-610c-42bd-bc5d-a67adbbddbee"
      }
    },
    "owner": "yeongmun"
  }
}
