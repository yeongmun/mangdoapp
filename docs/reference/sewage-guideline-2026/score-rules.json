 "formulas": {
  "E1": {
   "formula": "E1 = M × F",
   "M": "평가점수(a5 b4 c3 d2 e1)",
   "F": "평가유형별 영향계수 [표 12.48]/[표 12.12]/[표 12.28]/[표 12.33]",
   "rounding": "소수점 이하 3째 자리에서 반올림(=소수 둘째 자리까지)"
  },
  "E2": {
   "formula": "E2 = min(E1)",
   "note": "개별부재 상태평가지수. 결과 등급은 [표 12.48]"
  },
  "E3": {
   "formula": "E3 = Σ(E2 × P) / ΣP,  P = A × W",
   "A": "[표 12.51] 조정계수 (a1 b2 c3 d6 e6) — E2의 등급으로",
   "W": "[표 12.50] 개별부재별 중요도(토목), 기전설비는 개별부재 동일 중요도(±20% 조정 가능, 합 100)",
   "rounding": "예시는 소수 둘째 자리(3.73, 3.43)"
  },
  "E4": {
   "formula": "E4 = Min + V1 × V2,  V1 = 0.3 × (Max − Min),  V2 = Σ(E3 × S) / (5 × ΣS)",
   "Min/Max": "복합부재 E3 중 최솟값/최댓값",
   "S": "복합부재 규모(용량, m3; 기전설비 예시는 토출량)",
   "note": "복합부재 중요도는 같다고 보고 규모만 반영"
  },
  "Es": {
   "formula": "Es = L + 0.3 × (H − L) × Σ_{i=1}^{N−2} M_i / (5 × (N − 2))   (N > 2);   Es = L + 0.3 × (H − L)   (N = 2)",
   "N": "안전성평가항목 수",
   "L": "검토항목 평가점수 중 최솟값",
   "H": "최댓값",
   "M_i": "최대·최솟값을 1개씩 뺀 나머지",
   "N1": "원문에 N=1 경우 없음 — 앱에서는 Es = L 로 처리 권장(주석)",
   "ref": "12.5.3 가."
  },
  "Et1": {
   "formula": "Et = MIN(Ec, Es)",
   "note": "안전성평가를 하지 않으면 상태평가결과 = 종합평가결과(Et = Ec). 안전성평가를 했으면 개별시설물 상태평가표는 따로 쓰지 않고 [표 12.63] 종합평가표로 작성"
  },
  "Et2": {
   "formula": "Et2 = Σ(Et1 × P) / ΣP,  P = A × S",
   "A": "[표 12.62] 조정계수 (A1 B2 C3 D6 E6)",
   "S": "개별시설물별 규모(㎥)",
   "note": "개별시설물 중요도 동일, 규모만 가중"
  },
  "Et3": {
   "formula": "Et3 = Σ(Et2 × P) / ΣP,  P = A × W",
   "W": "[표 12.65] 복합시설물별 중요도 수처리 70 / 슬러지 20 / 부대 10 (±20%)"
  },
  "Et4": {
   "formula": "Et4 = Σ(Et3 × P) / ΣP,  P = A × W",
   "W": "[표 12.67] 통합시설물 중요도 토목 70 / 기전 15 / 건축 15 (±20%). 원문 정의는 \"W : 복합시설물별 중요도\"라 적었으나 [표 12.67] 통합시설물 중요도를 씀",
   "grading": "[표 12.61] 대문자 A~E"
  }
 },
