 "formulas": {
  "E1": {
   "formula": "E1 = M × F",
   "rounding": "소수점 이하 3째 자리에서 반올림(=소수 둘째 자리까지)",
   "ref": "11.4.2 다. 2)"
  },
  "E2": {
   "formula": "E2 = min(E1)",
   "ref": "11.4.2 다. 2)"
  },
  "E3": {
   "formula": "E3 = Σ(E2 × P) / ΣP,  P = A × W",
   "vars": {
    "A": "[표 11.58] 조정계수 (E2 등급별)",
    "W": "중요도(weights.json)"
   },
   "ref": "11.4.2 다. 3)"
  },
  "E4": {
   "formula": "E4 = Min + V1 × V2,  V1 = 0.3 × (Max − Min),  V2 = Σ(E3 × S) / (5 × ΣS)",
   "vars": {
    "S": "복합부재 규모 — 관로: 관 단면적×연장(㎥), 조절지: 가로×세로×높이; 수로터널: 단면적×연장; 토목구조물: 조사면적(㎡); 기전설비: 시설용량(㎥/분)",
    "Max/Min": "복합부재 E3 중 최댓값/최솟값"
   },
   "note": "원문 식 \"V2 = ∑(E3 × S) / 5 ×∑S\"는 예시 계산상 Σ(E3×S)/(5×ΣS) 의미([표 11.69]에서 괄호 명시).",
   "ref": "11.4.2 다. 4)"
  },
  "Es": {
   "formula": "Es = L + 0.3(H − L) × ΣMi / (5 × (N − 2))  (N > 2);  Es = L + 0.3(H − L)  (N = 2)",
   "vars": {
    "N": "안전성평가 항목 수",
    "L": "평가점수 최솟값",
    "H": "평가점수 최댓값",
    "Mi": "최대·최솟값을 1개씩 뺀 나머지 점수"
   },
   "note": "N=1인 경우는 원문에 없음(앱에서는 Es = 해당 점수로 처리 권장, 해석).",
   "ref": "11.5.3 가."
  },
  "Et1": {
   "formula": "Et = MIN(Ec, Es); 안전성평가 미실시 시 상태평가결과로 갈음",
   "ref": "11.6.2 가. 1)"
  },
  "Et2": {
   "formula": "Et2 = Σ(Et1 × P) / ΣP,  P = A × S (개별시설물 규모 ㎡·㎥)",
   "note": "개별시설물 중요도는 동일하다고 보고 규모만 가중",
   "ref": "11.6.2 나. 2)"
  },
  "Et3": {
   "formula": "Et3 = Σ(Et2 × P) / ΣP,  P = A × S (복합시설물 규모 ㎥, ㎥/일)",
   "note": "본문은 \"[표 11.78]의 종합평가지수에 따른 조정계수(A)\"라 적었으나 조정계수 표는 [표 11.79](참조 오기)",
   "ref": "11.6.2 나. 3)"
  },
  "Et4": {
   "formula": "Et4 = Σ(Et3 × P) / ΣP,  P = A × W ([표 11.86] 통합시설물 중요도)",
   "note": "본문 \"복합시설물별 중요도(A)\"는 W의 오기. 결과는 대문자(안전등급).",
   "ref": "11.6.2 나. 4)"
  }
 },
