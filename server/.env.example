APS_CLIENT_ID=
APS_CLIENT_SECRET=
# 영문·숫자·-·_ 로만 20자 이상
APP_ACCESS_KEY=
# APS_BUCKET_KEY=
# PORT=3000
# 선택. 폰 앱이 쓸 고정 주소(이름 있는 터널). 있으면 npm run server가 임시 터널을 안 열고 이 주소를 .env.local에 쓴다
# APP_PUBLIC_URL=https://mangdo.daenong.day
# ODA File Converter 경로(선택, Windows). 있으면 DWG 업로드·DWG 산출이 된다
# ODA_PATH=C:\Program Files\ODA\ODAFileConverter 26.12.0\ODAFileConverter.exe
# 선택. 손글씨 인식(뷰어 속성창 '손글씨로 입력'). Anthropic API 키. 없으면 그 기능만 꺼진다
ANTHROPIC_API_KEY=
# 선택. 손글씨 인식 모델. 기본 claude-sonnet-5-5
HANDWRITING_MODEL=
